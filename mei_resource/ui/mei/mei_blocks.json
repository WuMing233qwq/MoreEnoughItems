                                "texture": "textures/ui/mei/icons/question"
                            }
                        }
                    ]
                }
            }
        ]
    },

    "frame": {
        "type": "image",
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "size": [60, 40],
        "layer": 0,
        "texture": "textures/ui/mei/recipe/recipe_bg"
    },

    "row_button_icon": {
        "type": "image",
        "$row_icon_size|default": ["100%+-4px", "100%+-4px"],
        "texture": "$row_icon",
        "size": "$row_icon_size",
        "layer": 5,
        "color": [0.478, 0.478, 0.478]
    },

    "row_button": {
        "type": "button",
        "size": [13, 13],
        "layer": 2,
        "$row_button_name|default": "button.mei.user.unused",
        "$row_icon|default": "textures/ui/mei/icons/tree",
        "default_control": "default",
        "hover_control": "hover",
        "pressed_control": "pressed",
        "is_handle_button_move_event": true,
        "button_mappings": [
            {
                "from_button_id": "button.menu_select",
                "to_button_id": "$row_button_name",
                "mapping_type": "pressed"
            },
            {
                "from_button_id": "button.menu_ok",
                "to_button_id": "$row_button_name",
                "mapping_type": "focused"
            }
        ],
        "controls": [
            {
                "default": {
                    "type": "image",
                    "texture": "textures/ui/mei/button/button",
                    "fill": true,
                    "controls": [
                        { "icon@MeiBlocks.row_button_icon": { "offset": [0, -1] } }
                    ]
                }
            },
            {
                "hover": {
                    "type": "image",
                    "texture": "textures/ui/mei/button/button_highlighted",
                    "fill": true,
                    "controls": [
                        { "icon@MeiBlocks.row_button_icon": { "offset": [0, -1] } },
                        { "hover_text@MeiBlocks.hover_text": {} }
                    ]
                }
            },
            {
                "pressed": {
                    "type": "image",
                    "texture": "textures/ui/mei/button/button_pressed",
                    "fill": true,
                    "controls": [
                        { "icon@MeiBlocks.row_button_icon": { "offset": [0, 0.5] } }
                    ]
                }
            }
        ]
    },

    "row_button_on@MeiBlocks.row_button": {
        "controls": [
            {
                "default": {
                    "type": "image",
                    "texture": "textures/ui/mei/button/button_pressed",
                    "fill": true,
                    "controls": [
                        { "icon@MeiBlocks.row_button_icon": { "offset": [0, 0.5], "color": [0.4824, 0.6078, 0.8667] } }
                    ]
                }
            },
            {
                "hover": {
                    "type": "image",
                    "texture": "textures/ui/mei/button/button_pressed_highlighted",
                    "fill": true,
                    "controls": [
                        { "icon@MeiBlocks.row_button_icon": { "offset": [0, 0.5], "color": [0.4824, 0.6078, 0.8667] } },
                        { "hover_text@MeiBlocks.hover_text": {} }
                    ]
                }
            },
            {
                "pressed": {
                    "type": "image",
                    "texture": "textures/ui/mei/button/button_pressed",
                    "fill": true,
                    "controls": [
                        { "icon@MeiBlocks.row_button_icon": { "offset": [0, 0.5], "color": [0.4824, 0.6078, 0.8667] } }
                    ]
                }
            }
        ]
    },

    "row_button_off@MeiBlocks.row_button": {
        "controls": [
            {
                "default": {
                    "type": "image",
                    "texture": "textures/ui/mei/button/button_disabled",
                    "fill": true,
                    "controls": [
                        { "icon@MeiBlocks.row_button_icon": { "offset": [0, 0] } }
                    ]
                }
            },
            {
                "hover": {
                    "type": "image",
                    "texture": "textures/ui/mei/button/button_disabled",
                    "fill": true,
                    "controls": [
                        { "icon@MeiBlocks.row_button_icon": { "offset": [0, 0] } },
                        { "hover_text@MeiBlocks.hover_text": {} }
                    ]
                }
            },
            {
                "pressed": {
                    "type": "image",
                    "texture": "textures/ui/mei/button/button_disabled",
                    "fill": true,
                    "controls": [
                        { "icon@MeiBlocks.row_button_icon": { "offset": [0, 0] } }
                    ]
                }
            }
        ]
    },

