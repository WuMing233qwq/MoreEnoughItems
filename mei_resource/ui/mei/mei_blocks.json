                                "anchor_to": "top_left",
                                "offset": [28, 0],
                                "visible": false
                            }
                        },
                        {
                            "plus@MeiBlocks.row_button": {
                                "$row_button_name": "button.mei.user.plus",
                                "$row_icon": "textures/ui/mei/icons/plus",
